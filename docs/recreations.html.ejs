<%
  // One System Preferences > Dock pane per Mac OS X release, rebuilt from
  // aqua.css components. `aquaEra` is the library era each one renders with
  // (aqua.css has no separate 10.1 or 10.5 era, so those borrow the nearest).
  const base = {
    sizeLabel: 'Dock Size:',
    minimizeLabel: 'Minimize using:',
    effectLabel: 'Genie Effect',
    toolbar: 'icons',
    pill: true,
    help: false,
    desktop: false,
  };
  // `layout` holds spacing measured from the original screenshots, in px:
  //   toolbar [top, icon-label gap, bottom], toolbarX [left, item padding, separator margin],
  //   nav [button height, top, left] for 10.4+, body [top, bottom] padding,
  //   gaps: space above each row, shift/colGap: form position and label-control gap,
  //   slider [width, x], radioPitch/radioFirst: radio spacing and first center,
  //   radio [y offset, circle-label gap],
  //   leftChecks/leftCheck: checkboxes under Magnification (10.0-10.1) and their indent,
  //   toolbarBg/band: toolbar and unified-band colors,
  //   font: pane text size, popup [height, min width], help [size, right, bottom].
  const eras = [
    {
      ...base, id: 'cheetah', release: '10.0', name: 'Cheetah', year: 2001,
      aquaEra: '10-0', chrome: 'pinstripe', width: 595, pill: false, desktop: true, fixedToolbar: true,
      magnification: true, checked: ['animate'],
      rows: ['size', 'magnification', 'autohide', 'separator', 'animate'],
      layout: {
        toolbarBg: 'repeating-linear-gradient(#fafafa 0 1px, #ffffff 1px 2px, #fafafa 2px 3px, #e9e9e9 3px 4px)',
        toolbar: [7, 3, 3],
        toolbarX: [0, 4, 6],
        body: [21, 15],
        gaps: { magnification: 12, autohide: 14, animate: 17 },
        shift: -22,
        slider: [204, 1.5],
        leftChecks: ['autohide', 'animate'],
        leftCheck: 4,
      },
      notes: 'Toolbar items on a fixed-width grid, no toolbar pill yet, and only three settings plus a separator.',
    },
    {
      ...base, id: 'puma', release: '10.1', name: 'Puma', year: 2001,
      aquaEra: '10-0', chrome: 'pinstripe', width: 595, desktop: true,
      rows: ['size', 'magnification', 'autohide', 'position', 'minimize', 'animate'],
      layout: {
        toolbarBg: 'repeating-linear-gradient(#fafafa 0 1px, #ffffff 1px 2px, #fafafa 2px 3px, #e9e9e9 3px 4px)',
        toolbar: [7, 3, 3],
        toolbarX: [6, 5.5, 7],
        body: [21, 29],
        gaps: { magnification: 12, autohide: 25, position: 19, minimize: 30, animate: 16 },
        shift: -27,
        colGap: 8,
        slider: [204, 2],
        radioPitch: 67.5,
        radioFirst: 10.6,
        radio: [-3, 6],
        leftChecks: ['autohide'],
        leftCheck: 12,
        popup: [23, 124],
      },
      notes: 'Adds the toolbar pill, Position on screen and the Genie/Scale popup. Rendered with the 10.0 era.',
    },
    {
      ...base, id: 'jaguar', release: '10.2', name: 'Jaguar', year: 2002,
      aquaEra: '10-2', chrome: 'pinstripe', width: 620,
      rows: ['size', 'magnification', 'position', 'minimize', 'animate', 'autohide'],
      layout: {
        toolbar: [7, 5, 3],
        toolbarX: [6, 7, 7.25],
        body: [23, 24],
        gaps: { magnification: 14, position: 17, minimize: 17, animate: 17, autohide: 4 },
        shift: -4,
        colGap: 11,
        slider: [211.5, 4.5],
        radioPitch: 70.5,
        radioFirst: 13.5,
        radio: [-4, 8],
        font: 13.5,
        popup: [24, 127],
      },
      notes: 'Same controls as Puma, reordered with the two checkboxes grouped at the bottom.',
    },
    {
      ...base, id: 'panther', release: '10.3', name: 'Panther', year: 2003,
      aquaEra: '10-3', chrome: 'panther', width: 620,
      rows: ['size', 'magnification', 'position', 'minimize', 'animate', 'autohide'],
      layout: {
        toolbar: [7, 5, 3],
        toolbarX: [6, 7, 7.25],
        body: [23, 25],
        gaps: { magnification: 14, position: 16, minimize: 18, animate: 17, autohide: 3 },
        shift: -4,
        colGap: 11,
        slider: [211.5, 4.5],
        radioPitch: 70.5,
        radioFirst: 13.5,
        radio: [-3, 8],
        font: 13.5,
        popup: [24, 127],
      },
      notes: 'Identical layout to Jaguar; the pinstripes fade to a near-solid light gray.',
    },
    {
      ...base, id: 'tiger', release: '10.4', name: 'Tiger', year: 2005,
      aquaEra: '10-4', chrome: 'tiger', width: 595, toolbar: 'nav', pill: false, help: true,
      rows: ['size', 'magnification', 'position', 'minimize', 'animate', 'autohide'],
      layout: {
        nav: [20, 3, 6],
        body: [21, 23],
        gaps: { magnification: 12, position: 15, minimize: 16, animate: 15, autohide: 2 },
        shift: -2,
        colGap: 6,
        slider: [203, 5.5],
        radioPitch: 67.5,
        radioFirst: 13.6,
        radio: [-4, 7],
        popup: [22, 122],
        help: [21, 13, 20],
      },
      notes: 'Icon toolbar replaced by Back/Forward, Show All and a Spotlight search field. A Help button appears.',
    },
    {
      ...base, id: 'leopard', release: '10.5', name: 'Leopard', year: 2007,
      aquaEra: '10-6', chrome: 'unified', width: 668, toolbar: 'nav', pill: false, help: true,
      sizeLabel: 'Size:',
      rows: ['size', 'magnification', 'position', 'minimize', 'animate', 'autohide'],
      layout: {
        band: ['#c5c5c5', '#969696', '#e8e8e8'],
        nav: [19, 2, 8],
        body: [25, 22],
        gaps: { magnification: 10, position: 15, minimize: 16, animate: 15, autohide: 2 },
        shift: -1,
        colGap: 8,
        slider: [203, 2],
        radioPitch: 66.5,
        radioFirst: 12.1,
        radio: [-3, 7],
        popup: [22, 122],
        help: [19, 18, 19],
      },
      notes: 'Unified dark-gray toolbar, no pill, flat gray body. Rendered with the 10.6 era.',
    },
    {
      ...base, id: 'snow-leopard', release: '10.6', name: 'Snow Leopard', year: 2009,
      aquaEra: '10-6', chrome: 'unified', width: 668, toolbar: 'nav', pill: false, help: true,
      sizeLabel: 'Size:', minimizeLabel: 'Minimize windows using:', effectLabel: 'Genie effect',
      rows: ['size', 'magnification', 'position', 'minimize', 'intoIcon', 'animate', 'autohide'],
      layout: {
        nav: [19, 2, 8],
        body: [25, 21],
        gaps: { magnification: 10, position: 15, minimize: 16, intoIcon: 15, animate: 0, autohide: 0 },
        shift: -18,
        colGap: 8,
        slider: [203, 2],
        radioPitch: 66.5,
        radioFirst: 12.1,
        radio: [-3, 7],
        popup: [22, 122],
        help: [21, 15, 18],
      },
      notes: 'Adds "Minimize windows into application icon"; labels switch to sentence case.',
    },
  ];
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Mac OS X System Preferences, rebuilt release by release with aqua.css.">
  <title>Era Recreations - aqua.css</title>
  <link rel="icon" href="icon/finder.svg" type="image/svg+xml">
  <link rel="stylesheet" href="aqua.css">
  <link rel="stylesheet" href="recreations.css">
</head>
<body class="rc-page">
  <header class="rc-header">
    <h1>Era Recreations</h1>
    <p>
      The Dock preference pane from every Mac OS X release between 10.0 and 10.6,
      rebuilt from aqua.css components. Each one sits in a wrapper carrying
      <code>data-aqua-era</code>, so the library's era styles apply to it.
      Reference: the <a href="https://512pixels.net/projects/aqua-screenshot-library/">Aqua Screenshot Library</a>.
    </p>
    <nav class="rc-jump" aria-label="Releases">
<% eras.forEach((pane) => { %>
      <a href="#<%= pane.id %>"><%= pane.release %> <%= pane.name %></a>
<% }) %>
    </nav>
    <p><a href="index.html">&larr; Back to the component docs</a></p>
  </header>

  <main>
<% eras.forEach((pane) => { %>
    <section class="rc-section" id="<%= pane.id %>">
      <h2>Mac OS X <%= pane.release %> <%= pane.name %> <span class="rc-year"><%= pane.year %></span></h2>
      <p class="rc-notes">
        <%= pane.notes %>
        <code>data-aqua-era="<%= pane.aquaEra %>"</code>
      </p>
      <%- include('partials/recreations/_dock-pane', { pane }) %>
    </section>
<% }) %>
  </main>
</body>
</html>
