<%#
  System Preferences > Dock, rebuilt from aqua.css components.
  Expects `pane` (one entry from the eras list in recreations.html.ejs).
%>
<% const uid = pane.id; %>
<% const icon = (name) => include('_toolbar-icons', { name, release: pane.id }).trim(); %>
<%
  // Spacing measured from the original screenshots (see `layout` in recreations.html.ejs)
  const layout = pane.layout || {};
  const vars = Object.entries({
    '--rc-tb-top': layout.toolbar && layout.toolbar[0],
    '--rc-tb-gap': layout.toolbar && layout.toolbar[1],
    '--rc-tb-bottom': layout.toolbar && layout.toolbar[2],
    '--rc-body-top': layout.body && layout.body[0],
    '--rc-body-bottom': layout.body && layout.body[1],
    '--rc-shift': layout.shift,
    '--rc-col-gap': layout.colGap,
    '--rc-radio-pitch': layout.radioPitch,
    '--rc-radio-first': layout.radioFirst,
    '--rc-left-check': layout.leftCheck,
    '--rc-tb-left': layout.toolbarX && layout.toolbarX[0],
    '--rc-tb-item-pad': layout.toolbarX && layout.toolbarX[1],
    '--rc-tb-sep': layout.toolbarX && layout.toolbarX[2],
    '--rc-slider-w': layout.slider && layout.slider[0],
    '--rc-slider-x': layout.slider && layout.slider[1],
    '--rc-font': layout.font,
    '--rc-popup-h': layout.popup && layout.popup[0],
    '--rc-popup-w': layout.popup && layout.popup[1],
    '--rc-help-size': layout.help && layout.help[0],
    '--rc-help-right': layout.help && layout.help[1],
    '--rc-help-bottom': layout.help && layout.help[2],
    '--rc-nav-h': layout.nav && layout.nav[0],
    '--rc-nav-top': layout.nav && layout.nav[1],
    '--rc-nav-left': layout.nav && layout.nav[2],
  }).filter(([, v]) => v !== undefined).map(([k, v]) => `${k}: ${v}px`).join('; ');
  const gap = (row, i) => (i === 0 ? 0 : (layout.gaps && layout.gaps[row] !== undefined ? layout.gaps[row] : 14));
  const at = (row, i) => `data-row="${row}" style="margin-top: ${gap(row, i)}px"`;
%>
<div class="rc-stage<%= pane.desktop ? ' rc-stage--desktop' : '' %>" data-aqua-era="<%= pane.aquaEra %>">
  <div class="window rc-prefs rc-prefs--<%= pane.chrome %>" style="width: <%= pane.width %>px;<%= vars ? ' ' + vars + ';' : '' %>">
    <div class="title-bar">
      <div class="traffic-lights traffic-lights--always-colored">
        <div class="aqua-light aqua-red" role="button" tabindex="0" aria-label="Close"><span class="icon">×</span></div>
        <div class="aqua-light aqua-yellow" role="button" tabindex="0" aria-label="Minimize"><span class="icon">−</span></div>
        <div class="aqua-light aqua-green aqua-inactive" role="button" aria-disabled="true" aria-label="Maximize"><span class="icon">+</span></div>
      </div>
      <div class="title-bar-text">Dock</div>
<% if (pane.pill) { %>
      <button class="rc-toolbar-pill" aria-label="Hide toolbar"></button>
<% } %>
    </div>
<% if (pane.toolbar === 'icons') { %>
    <div class="rc-icon-toolbar<%= pane.fixedToolbar ? ' rc-icon-toolbar--fixed' : '' %>" role="toolbar">
      <button class="rc-icon-button"><%- icon('showAll') %><span>Show All</span></button>
      <div class="rc-icon-separator"></div>
      <button class="rc-icon-button"><%- icon('displays') %><span>Displays</span></button>
      <button class="rc-icon-button"><%- icon('sound') %><span>Sound</span></button>
      <button class="rc-icon-button"><%- icon('network') %><span>Network</span></button>
      <button class="rc-icon-button"><%- icon('startupDisk') %><span>Startup Disk</span></button>
    </div>
<% } else { %>
    <div class="rc-nav-toolbar" role="toolbar">
      <div class="aqua-segmented-control rc-back-forward">
        <button class="aqua-button aqua-button--secondary" aria-label="Back"><span>&#9664;</span></button>
        <button class="aqua-button aqua-button--secondary" aria-label="Forward" disabled><span>&#9654;</span></button>
      </div>
      <button class="aqua-button aqua-button--secondary rc-show-all"><span>Show All</span></button>
      <input type="search" class="aqua-search-field aqua-focus-ring is-focused rc-search" aria-label="Search System Preferences">
    </div>
<% } %>
    <div class="window-body rc-pane-body">
      <div class="rc-pane">
      <div class="rc-form">
<% pane.rows.forEach((row, i) => { %>
<% if (row === 'size') { %>
        <label class="rc-label" for="<%= uid %>-size" <%- at(row, i) %>><%= pane.sizeLabel %></label>
        <div class="rc-control" <%- at(row, i) %>>
          <div class="aqua-slider-custom alternative-thumb rc-slider" id="<%= uid %>-size" role="slider" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100" tabindex="0">
            <div class="track"></div>
            <div class="thumb" style="--rc-value: 0.43;"><div class="shimmer"></div></div>
          </div>
          <div class="rc-scale"><span>Small</span><span>Large</span></div>
        </div>
<% } else if (row === 'magnification') { %>
        <div class="rc-label" <%- at(row, i) %>>
          <input type="checkbox" id="<%= uid %>-mag"<%= (pane.checked || []).includes('magnification') ? ' checked' : '' %>>
          <label for="<%= uid %>-mag">Magnification:</label>
        </div>
        <div class="rc-control" <%- at(row, i) %>>
          <div class="aqua-slider-custom alternative-thumb rc-slider<%= pane.magnification ? '' : ' disabled' %>" role="slider" aria-label="Magnification" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"<%= pane.magnification ? ' tabindex="0"' : ' aria-disabled="true"' %>>
            <div class="track"></div>
            <div class="thumb" style="--rc-value: 1;"><div class="shimmer"></div></div>
          </div>
          <div class="rc-scale"><span>Min</span><span>Max</span></div>
        </div>
<% } else if (row === 'position') { %>
        <div class="rc-label" <%- at(row, i) %>>Position on screen:</div>
        <div class="rc-control rc-radios" role="radiogroup" aria-label="Position on screen" <%- at(row, i) %>>
<% ['Left', 'Bottom', 'Right'].forEach((side) => { %>
          <div class="rc-radio">
            <input type="radio" name="<%= uid %>-position" id="<%= uid %>-pos-<%= side.toLowerCase() %>"<%= side === 'Bottom' ? ' checked' : '' %>>
            <label for="<%= uid %>-pos-<%= side.toLowerCase() %>"><%= side %></label>
          </div>
<% }) %>
        </div>
<% } else if (row === 'minimize') { %>
        <label class="rc-label" for="<%= uid %>-effect" <%- at(row, i) %>><%= pane.minimizeLabel %></label>
        <div class="rc-control" <%- at(row, i) %>>
          <div class="select-wrapper">
            <select id="<%= uid %>-effect">
              <option><%= pane.effectLabel %></option>
              <option>Scale <%= pane.effectLabel.endsWith('effect') ? 'effect' : 'Effect' %></option>
            </select>
            <span class="select-button"></span>
            <span class="select-arrows">
              <span class="arrow-up">&#9650;</span>
              <span class="arrow-down">&#9660;</span>
            </span>
          </div>
        </div>
<% } else if (row === 'separator') { %>
        <hr class="rc-separator" <%- at(row, i) %>>
<% } else { %>
<% const checks = {
  autohide: ['autohide', 'Automatically hide and show the Dock'],
  animate: ['animate', 'Animate opening applications'],
  intoIcon: ['into-icon', 'Minimize windows into application icon'],
}; const [key, text] = checks[row]; %>
        <div class="rc-check<%= (layout.leftChecks || []).includes(row) ? ' rc-check--left' : '' %>" <%- at(row, i) %>>
          <input type="checkbox" id="<%= uid %>-<%= key %>"<%= (pane.checked || []).includes(row) ? ' checked' : '' %>>
          <label for="<%= uid %>-<%= key %>"><%= text %></label>
        </div>
<% } %>
<% }) %>
      </div>
<% if (pane.help) { %>
      <button class="aqua-button help rc-help" aria-label="Help"><span>?</span></button>
<% } %>
      </div>
    </div>
  </div>
</div>
