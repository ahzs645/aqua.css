<%#
  Toolbar icons for the System Preferences recreations: period icons from
  docs/recreation-icons/ (see the README there), so comparisons with the real
  screenshots are about the interface rather than the artwork.
  Expects `name` and `release` (the pane id, e.g. 'panther').
%>
<% const panther = release === 'panther';
   const files = {
     showAll: panther ? 'system-preferences-10-3.png' : 'system-preferences-10-0.png',
     displays: 'displays.png',
     sound: 'sound.png',
     network: panther ? 'network-10-3.png' : 'network-10-2.png',
     startupDisk: 'startup-disk.png',
   }; %>
<img src="recreation-icons/<%= files[name] %>" width="32" height="32" alt="">
